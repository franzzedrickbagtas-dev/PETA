<HTML>
<HEAD>
<META CHARSET="UTF-8">
<META NAME="VIEWPORT" CONTENT="WIDTH=DEVICE-WIDTH, INITIAL-SCALE=1.0">
<STYLE>
:root {
    --bg: #080b16;
    --panel: rgba(19, 25, 43, 0.92);
    --line: rgba(255, 255, 255, 0.12);
    --text: #f5f7ff;
    --muted: #a7b0ca;
    --cyan: #67e8f9;
    --purple: #a78bfa;
}

* { box-sizing: border-box; }

HTML { min-height: 100%; }

BODY {
    margin: 0;
    min-height: 100vh;
    padding: 38px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    font-family: "Segoe UI", Arial, sans-serif;
    line-height: 1.5;
    background:
        radial-gradient(ellipse at 12% 8%, rgba(124, 58, 237, 0.22), transparent 34rem),
        radial-gradient(ellipse at 91% 35%, rgba(34, 211, 238, 0.14), transparent 30rem),
        var(--bg);
}

.profile-shell {
    position: relative;
    isolation: isolate;
    width: min(760px, 100%);
    margin: auto;
    padding: clamp(22px, 5vw, 48px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 30px;
    background: linear-gradient(145deg, rgba(23, 29, 50, 0.97), rgba(12, 16, 30, 0.96));
    box-shadow: 0 28px 85px rgba(0, 0, 0, 0.4), 0 0 50px rgba(103, 232, 249, 0.035);
}

.profile-shell::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: 230px;
    height: 230px;
    top: -155px;
    right: -100px;
    border: 1px solid rgba(103, 232, 249, 0.27);
    border-radius: 50%;
    box-shadow: 0 0 0 26px rgba(103, 232, 249, 0.025), 0 0 0 55px rgba(167, 139, 250, 0.025);
}

H1 {
    margin: 0 auto 28px;
    max-width: 610px;
    text-align: center;
    font-size: clamp(1.65rem, 5vw, 2.55rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
}

H1 P { margin: 0; }

H1 FONT {
    color: var(--cyan);
    font-family: "Century Gothic", "Segoe UI", Arial, sans-serif;
    font-weight: 800;
    background: linear-gradient(95deg, var(--cyan), #ffffff 48%, var(--purple));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}.portrait-card {
    position: relative;
    width: min(470px, 100%);
    margin: 0 auto 17px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: linear-gradient(145deg, rgba(30, 38, 63, 0.76), rgba(15, 20, 36, 0.82));
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.16);
}.portrait-card::before {
    display: block;
    margin: 0 0 14px;
    color: var(--muted);
    text-align: left;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
}

.portrait-card::before { content: "PLATINUM (BAGTAS, FRANZ ZEDRICK B. · PROFILE PHOTO"; }

.portrait-card IMG {
    display: block;
    width: 200px;
    height: 200px;
    max-width: 100%;
    margin: 0 auto;
    object-fit: cover;
    object-position: center;
    border: 3px solid rgba(103, 232, 249, 0.7);
    border-radius: 19px;
    background: #111728;
    box-shadow: 0 0 0 6px rgba(103, 232, 249, 0.055), 0 12px 28px rgba(0, 0, 0, 0.28);
}

@media (max-width: 480px) {
    BODY { padding: 16px 10px; }
    .profile-shell { padding: 22px 14px; border-radius: 23px; }
    H1 { margin-bottom: 22px; }.portrait-card { padding: 15px; border-radius: 18px; }
}

/* EXTRA EFFECTS: animated ambient light, card shine, and media feedback */
@keyframes ambient-drift {
    0% { background-position: 0% 0%, 100% 20%, 50% 50%; }
    50% { background-position: 18% 15%, 82% 46%, 50% 50%; }
    100% { background-position: 0% 0%, 100% 20%, 50% 50%; }
}

@keyframes title-glow {
    0%, 100% { filter: drop-shadow(0 0 5px rgba(103, 232, 249, 0.10)); }
    50% { filter: drop-shadow(0 0 16px rgba(167, 139, 250, 0.28)); }
}

@keyframes slow-sweep {
    0%, 15% { left: -55%; opacity: 0; }
    35% { opacity: .65; }
    65%, 100% { left: 130%; opacity: 0; }
}

@keyframes equalize {
    0%, 100% { transform: scaleY(.24); }
    25% { transform: scaleY(.68); }
    50% { transform: scaleY(1); }
    75% { transform: scaleY(.43); }
}

@keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 0 rgba(103, 232, 249, .42); }
    50% { box-shadow: 0 0 0 6px rgba(103, 232, 249, 0); }
}

BODY {
    background-size: 150% 150%, 150% 150%, auto;
    animation: ambient-drift 18s ease-in-out infinite;
}

.profile-shell {
    transition: border-color .35s ease, box-shadow .35s ease, transform .35s ease;
}

.profile-shell:hover {
    border-color: rgba(103, 232, 249, .25);
    box-shadow: 0 30px 90px rgba(0, 0, 0, .44), 0 0 58px rgba(103, 232, 249, .075);
}

H1 FONT { animation: title-glow 5.5s ease-in-out infinite; }.portrait-card {
    overflow: hidden;
    transition: transform .32s ease, border-color .32s ease, box-shadow .32s ease, background .32s ease;
}.portrait-card::after {
    content: "";
    position: absolute;
    z-index: 0;
    pointer-events: none;
    top: -70%;
    left: -55%;
    width: 34%;
    height: 240%;
    opacity: 0;
    transform: rotate(24deg);
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.075), transparent);
    animation: slow-sweep 10s ease-in-out infinite;
}.portrait-card:hover {
    transform: translateY(-5px);
    border-color: rgba(103, 232, 249, .43);
    box-shadow: 0 18px 42px rgba(0, 0, 0, .28), 0 0 28px rgba(103, 232, 249, .075);
}

.portrait-card IMG {
    position: relative;
    z-index: 1;
    transition: transform .4s ease, border-radius .4s ease, box-shadow .4s ease, filter .4s ease;
    filter: saturate(1.08) contrast(1.02);
}

.portrait-card:hover IMG {
    transform: scale(1.035) rotate(-1deg);
    border-radius: 25px;
    box-shadow: 0 0 0 7px rgba(167, 139, 250, .09), 0 0 34px rgba(103, 232, 249, .24);
}

.is-playing A { color: var(--cyan); }
A:focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; }

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
    }
}



/* Intro screen */
.intro-screen { position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; min-height: 100vh; padding: 24px; overflow: hidden; background: radial-gradient(ellipse at 15% 15%,rgba(124,58,237,.32),transparent 36rem),radial-gradient(ellipse at 88% 78%,rgba(34,211,238,.17),transparent 32rem),#080b16; }
.intro-glow { position: fixed; width: 340px; height: 340px; border: 1px solid rgba(167,139,250,.16); border-radius: 50%; animation: intro-float 8s ease-in-out infinite; pointer-events: none; }
.intro-glow:before,.intro-glow:after { content:""; position:absolute; inset:28px; border:1px solid rgba(103,232,249,.14); border-radius:50%; }
.intro-glow:after { inset:62px; }
.intro-g1 { top:-150px; left:-110px; } .intro-g2 { right:-180px; bottom:-170px; animation-delay:-3s; }
.intro-card { position:relative; width:min(760px,100%); padding:clamp(32px,7vw,68px) clamp(24px,6vw,58px); text-align:center; border:1px solid rgba(255,255,255,.13); border-radius:30px; background:rgba(16,21,38,.88); box-shadow:0 24px 80px rgba(0,0,0,.35); backdrop-filter:blur(16px); animation:intro-appear .9s ease both; }
.intro-tag { display:inline-flex; align-items:center; gap:9px; padding:8px 13px; border:1px solid rgba(167,139,250,.28); border-radius:999px; background:rgba(167,139,250,.09); color:#d9ccff; font-size:.76rem; letter-spacing:.15em; text-transform:uppercase; }
.intro-dot { width:7px; height:7px; border-radius:50%; background:var(--cyan); box-shadow:0 0 14px var(--cyan); }
.intro-card h1 { margin:25px 0 12px; max-width:none; font-size:clamp(2.5rem,8vw,5rem); line-height:1.03; letter-spacing:-.055em; color:var(--text); }
.intro-card h1 span { display:block; color:var(--purple); text-shadow:0 0 32px rgba(167,139,250,.22); }
.intro-card p { max-width:490px; margin:0 auto; color:var(--muted); font-size:1.04rem; line-height:1.8; }
.intro-line { width:66px; height:3px; margin:26px auto; background:linear-gradient(90deg,var(--purple),var(--cyan)); border-radius:5px; }
.intro-open-btn { display:inline-flex; align-items:center; justify-content:center; gap:12px; margin-top:32px; padding:15px 24px; border:0; border-radius:14px; color:#0b1020; font:750 1rem 'Segoe UI',Arial,sans-serif; cursor:pointer; background:linear-gradient(110deg,#c4b5fd,#67e8f9); box-shadow:0 10px 30px rgba(103,232,249,.14); transition:transform .2s ease,box-shadow .2s ease; }
.intro-open-btn:hover { transform:translateY(-3px); box-shadow:0 15px 36px rgba(167,139,250,.25); }
.intro-arrow { font-size:1.2rem; transition:transform .2s; } .intro-open-btn:hover .intro-arrow { transform:translateX(4px); }
.intro-foot { margin-top:34px!important; font-size:.78rem!important; letter-spacing:.12em; text-transform:uppercase; color:#77819e!important; }
#website-content { width:100%; }
body.website-open { display:block; padding:38px 16px; }
@keyframes intro-appear { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:translateY(0); } }
@keyframes intro-float { 0%,100% { transform:translateY(0) rotate(0); } 50% { transform:translateY(16px) rotate(7deg); } }
/* Cinematic intro atmosphere: moving aurora, orbit rings, and a light-burst transition */
.intro-screen::before { content:""; position:absolute; inset:-25%; z-index:0; pointer-events:none; background: conic-gradient(from 0deg at 50% 50%, transparent 0 18%, rgba(103,232,249,.08) 24%, transparent 31% 48%, rgba(167,139,250,.12) 56%, transparent 64% 100%); filter:blur(28px); animation: aurora-turn 24s linear infinite; }
.intro-screen::after { content:""; position:absolute; z-index:1; left:50%; top:50%; width:10vmax; height:10vmax; border-radius:50%; opacity:0; pointer-events:none; background:radial-gradient(circle,rgba(255,255,255,.98) 0%,rgba(103,232,249,.65) 12%,rgba(167,139,250,.36) 34%,transparent 70%); transform:translate(-50%,-50%) scale(.05); }
.intro-screen.is-opening::after { animation: portal-burst 1s cubic-bezier(.12,.72,.18,1) both; }
.intro-glow { box-shadow:0 0 55px rgba(167,139,250,.08), inset 0 0 45px rgba(103,232,249,.035); }
.intro-glow::before { box-shadow:0 0 35px rgba(103,232,249,.06); }
.intro-card { z-index:2; overflow:hidden; border-color:rgba(255,255,255,.18); background:linear-gradient(135deg,rgba(19,25,45,.9),rgba(10,14,29,.82)); box-shadow:0 25px 90px rgba(0,0,0,.42),0 0 70px rgba(103,232,249,.055); animation:intro-appear 1.1s cubic-bezier(.2,.8,.2,1) both, card-breathe 7s 1.2s ease-in-out infinite; }
.intro-card::before { content:""; position:absolute; inset:0; border-radius:inherit; padding:1px; background:linear-gradient(115deg,rgba(103,232,249,.65),transparent 25%,rgba(167,139,250,.55) 52%,transparent 74%,rgba(103,232,249,.45)); -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0); -webkit-mask-composite:xor; mask-composite:exclude; pointer-events:none; opacity:.7; background-size:220% 220%; animation:border-shimmer 8s linear infinite; }
.intro-tag { box-shadow:0 0 26px rgba(167,139,250,.09); animation:tag-glow 3.5s ease-in-out infinite; }
.intro-dot { animation:dot-pulse 1.8s ease-in-out infinite; }
.intro-card h1 { animation:title-arrive .9s .12s both cubic-bezier(.16,1,.3,1); }
.intro-card h1 span { background:linear-gradient(100deg,#c4b5fd 10%,#67e8f9 45%,#e9d5ff 65%,#a78bfa 90%); background-size:220% auto; -webkit-background-clip:text; background-clip:text; color:transparent; animation:gradient-flow 6s linear infinite; filter:drop-shadow(0 0 20px rgba(167,139,250,.15)); }
.intro-line { position:relative; overflow:hidden; width:96px; box-shadow:0 0 18px rgba(103,232,249,.28); animation:line-grow .8s .35s both; }
.intro-line::after { content:""; position:absolute; inset:0; background:linear-gradient(90deg,transparent,#fff,transparent); transform:translateX(-110%); animation:line-sweep 2.8s 1s ease-in-out infinite; }
.intro-open-btn { position:relative; overflow:hidden; isolation:isolate; box-shadow:0 10px 30px rgba(103,232,249,.18),0 0 0 1px rgba(255,255,255,.14) inset; transition:transform .25s ease,box-shadow .25s ease,filter .25s ease; }
.intro-open-btn::before { content:""; position:absolute; inset:-50% auto -50% -35%; width:24%; transform:translateX(-180%) skewX(-20deg); background:rgba(255,255,255,.65); filter:blur(5px); z-index:-1; animation:button-glint 4.2s 1.5s ease-in-out infinite; }
.intro-open-btn:hover { transform:translateY(-4px) scale(1.025); filter:saturate(1.15); box-shadow:0 18px 44px rgba(103,232,249,.24),0 0 28px rgba(167,139,250,.18); }
.intro-open-btn:active { transform:translateY(0) scale(.985); }
.intro-foot { animation:soft-fade 2.8s ease-in-out infinite; }
.intro-sparkle { position:absolute; z-index:1; width:5px; height:5px; border-radius:50%; background:#d9faff; box-shadow:0 0 12px 3px rgba(103,232,249,.45); pointer-events:none; animation:sparkle-drift 5s ease-in-out infinite; }
.sparkle-one { left:13%; top:29%; animation-delay:-1s; }
.sparkle-two { right:16%; top:24%; width:3px; height:3px; animation-delay:-3s; }
.sparkle-three { right:22%; bottom:18%; width:4px; height:4px; animation-delay:-2s; }
@keyframes sparkle-drift { 0%,100% { opacity:.25; transform:translate3d(0,0,0) scale(.7); } 50% { opacity:1; transform:translate3d(12px,-20px,0) scale(1.35); } }
/* Extra polish: layered orbit rings and a richer field of drifting light particles */
.intro-orbit { position:absolute; z-index:1; left:50%; top:50%; width:min(88vw,920px); height:min(88vw,920px); border:1px solid rgba(167,139,250,.10); border-radius:50%; transform:translate(-50%,-50%) rotate(-18deg); pointer-events:none; box-shadow:0 0 50px rgba(103,232,249,.025),inset 0 0 50px rgba(167,139,250,.025); }
.intro-orbit::before,.intro-orbit::after { content:""; position:absolute; border:1px solid rgba(103,232,249,.10); border-radius:50%; inset:9%; }
.intro-orbit::after { inset:21%; border-color:rgba(167,139,250,.10); }
.orbit-one { animation:orbit-drift 30s linear infinite; }
.orbit-two { width:min(62vw,650px); height:min(62vw,650px); transform:translate(-50%,-50%) rotate(35deg); border-style:dashed; border-color:rgba(103,232,249,.08); animation:orbit-drift 42s linear infinite reverse; }
.intro-sparkle { animation:sparkle-drift 5s ease-in-out infinite, sparkle-twinkle 2.8s ease-in-out infinite; }
.sparkle-four { left:27%; top:70%; width:3px; height:3px; animation-delay:-2.4s,-.8s; }
.sparkle-five { right:31%; top:68%; width:6px; height:6px; animation-delay:-4s,-1.5s; }
.sparkle-six { left:8%; top:52%; width:3px; height:3px; animation-delay:-1.2s,-2s; }
.sparkle-seven { right:8%; top:44%; width:4px; height:4px; animation-delay:-3.3s,-.4s; }
.sparkle-eight { left:42%; top:13%; width:3px; height:3px; animation-delay:-2.1s,-1.1s; }
.sparkle-nine { right:43%; bottom:10%; width:4px; height:4px; animation-delay:-4.5s,-2.2s; }
@keyframes orbit-drift { from { transform:translate(-50%,-50%) rotate(0deg) scale(1); } 50% { transform:translate(-50%,-50%) rotate(180deg) scale(1.035); } to { transform:translate(-50%,-50%) rotate(360deg) scale(1); } }
@keyframes sparkle-twinkle { 0%,100% { filter:brightness(.7); } 50% { filter:brightness(1.8); } }
@media (max-width:600px) { .intro-orbit { width:125vw; height:125vw; } .orbit-two { width:90vw; height:90vw; } }

/* The actual website enters like a cinematic reveal, then each section follows */
.intro-screen.is-opening { animation: intro-exit .95s cubic-bezier(.7,0,.2,1) forwards; pointer-events:none; }
.intro-screen.is-opening .intro-card { animation: card-zoom-out .68s .08s cubic-bezier(.6,0,.2,1) forwards; }
#website-content.reveal-site { animation: website-reveal 1.15s cubic-bezier(.16,1,.3,1) both; }
#website-content.reveal-site .portrait-card { animation: section-rise .9s .2s cubic-bezier(.16,1,.3,1) both; }
#website-content.reveal-site .hobbies-card { animation: section-rise .9s .38s cubic-bezier(.16,1,.3,1) both; }
#website-content.reveal-site .anime-card { animation: section-rise .9s .54s cubic-bezier(.16,1,.3,1) both; }
#website-content.reveal-site .dream-card { animation: section-rise .9s .7s cubic-bezier(.16,1,.3,1) both; }
#website-content.reveal-site .dream-card table { animation: table-arrive .8s .95s cubic-bezier(.16,1,.3,1) both; }
@keyframes table-arrive { from { opacity:0; transform:translateY(14px) scale(.985); } to { opacity:1; transform:translateY(0) scale(1); } }
#website-content.reveal-site .profile-shell > h1 { animation: title-arrive .9s .08s both cubic-bezier(.16,1,.3,1); }
#website-content .portrait-card, #website-content .hobbies-card, #website-content .anime-card, #website-content .dream-card { transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease; }
#website-content .portrait-card:hover, #website-content .hobbies-card:hover, #website-content .anime-card:hover, #website-content .dream-card:hover { transform:translateY(-4px); box-shadow:0 20px 48px rgba(0,0,0,.28),0 0 24px rgba(103,232,249,.08); border-color:rgba(103,232,249,.32); }
#website-content table { border-collapse:separate; border-spacing:0; overflow:hidden; border-radius:12px; }
#website-content table tr { transition:background .25s ease; }
#website-content table tr:hover { background:rgba(103,232,249,.09)!important; }
@keyframes intro-appear { from { opacity:0; transform:translateY(30px) scale(.96); filter:blur(8px); } to { opacity:1; transform:translateY(0) scale(1); filter:blur(0); } }
