/* Main website: cinematic ambient effects and richer interactions */
@keyframes main-aurora-drift { 0%,100% { transform:translate3d(0,0,0) scale(1); } 50% { transform:translate3d(3vw,-2vh,0) scale(1.12); } }
@keyframes main-particle-float { 0% { transform:translate3d(0,15px,0) scale(.75); opacity:0; } 15% { opacity:.75; } 75% { opacity:.55; } 100% { transform:translate3d(var(--drift,18px),-100vh,0) scale(1.25); opacity:0; } }
@keyframes main-title-light { 0%,100% { filter:drop-shadow(0 0 5px rgba(103,232,249,.12)); letter-spacing:1px; } 50% { filter:drop-shadow(0 0 20px rgba(167,139,250,.42)); letter-spacing:2.2px; } }
@keyframes main-card-border { 0%,100% { background-position:0% 50%; } 50% { background-position:100% 50%; } }
@keyframes main-list-enter { from { opacity:0; transform:translateX(-18px); } to { opacity:1; transform:translateX(0); } }
@keyframes main-image-breathe { 0%,100% { box-shadow:0 0 0 5px rgba(103,232,249,.06),0 0 24px rgba(103,232,249,.12); } 50% { box-shadow:0 0 0 8px rgba(167,139,250,.09),0 0 42px rgba(167,139,250,.23); } }
body.website-open { background:#080b16; }
body.website-open::before, body.website-open::after { content:""; position:fixed; z-index:0; width:min(55vw,650px); height:min(55vw,650px); border-radius:50%; pointer-events:none; filter:blur(75px); opacity:.15; animation:main-aurora-drift 16s ease-in-out infinite; }
body.website-open::before { left:-20vw; top:10vh; background:radial-gradient(circle, #8b5cf6 0%, transparent 68%); }
