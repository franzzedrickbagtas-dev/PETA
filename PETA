<SCRIPT>
function openMyWebsite() {
  const intro = document.getElementById('intro-screen');
  const website = document.getElementById('website-content');
  const button = document.querySelector('.intro-open-btn');
  if (intro.classList.contains('is-opening')) return;
  if (button) button.disabled = true;
  intro.classList.add('is-opening');
  website.style.display = 'block';
  website.classList.add('reveal-site');
  document.body.classList.add('website-open');
  window.scrollTo({ top: 0, behavior: 'smooth' });

  // Add a gentle layer of floating light particles to the main page.
  if (!document.getElementById('main-particles')) {
    const particleLayer = document.createElement('div');
    particleLayer.id = 'main-particles';
    particleLayer.setAttribute('aria-hidden', 'true');
    for (let i = 0; i < 30; i++) {
      const particle = document.createElement('span');
      particle.className = 'main-particle';
      particle.style.left = (Math.random() * 100) + '%';
      particle.style.setProperty('--duration', (10 + Math.random() * 13) + 's');
      particle.style.setProperty('--delay', (-Math.random() * 20) + 's');
      particle.style.setProperty('--drift', ((Math.random() * 70) - 35) + 'px');
      particle.style.width = particle.style.height = (2 + Math.random() * 3) + 'px';
      particleLayer.appendChild(particle);
    }
    document.body.appendChild(particleLayer);
  }

  // Re-trigger the main page entrance animations on each opening.
  window.setTimeout(function () {
    intro.style.display = 'none';
    website.classList.remove('reveal-site');
    void website.offsetWidth;
    website.classList.add('reveal-site');
  }, 760);
}


// Populate birth-date selectors and handle the registration form locally.
(function setupRegistrationForm(){
  const yearSelect=document.getElementById('birth-year');
  const daySelect=document.getElementById('birth-day');
  if(yearSelect){const currentYear=new Date().getFullYear();for(let y=currentYear;y>=currentYear-100;y--){const option=document.createElement('option');option.value=String(y);option.textContent=String(y);yearSelect.appendChild(option);}}
  if(daySelect){for(let d=1;d<=31;d++){const option=document.createElement('option');option.value=String(d);option.textContent=String(d);daySelect.appendChild(option);}}
  const form=document.getElementById('student-registration-form');
  const success=document.getElementById('registration-success');
  if(form){
    form.addEventListener('reset',function(){if(success)success.hidden=true;});
    // Pass the student's email to FormSubmit as the reply-to address.
    form.addEventListener('submit',function(){
      const emailInput=document.getElementById('email-address');
      const replyTo=document.getElementById('form-reply-to');
      if(emailInput && replyTo) replyTo.value=emailInput.value.trim();
    });
  }

})();

